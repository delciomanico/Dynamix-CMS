# Variáveis para o Dokploy (separador Environment). NÃO fazer commit dos valores reais.
# Gerar segredos: openssl rand -hex 32

PUBLIC_URL=https://cms.exemplo.com        # domínio configurado no Dokploy (com https, sem barra final)

POSTGRES_PASSWORD=                         # usar hex (sem caracteres especiais: entra num URL)
JWT_SECRET=                                # >= 32 caracteres
S3_SECRET_KEY=                             # password do MinIO (hex)
S3_ACCESS_KEY=dynamix

# Admin inicial criado pelo seed no 1.º deploy
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=                            # >= 12 caracteres
ADMIN_NAME=Administrador

# Seed do site Bchiwale: no 1.º deploy cria o projeto, componentes e conteúdo (docs/seeds.md)
SEED_SITES=bchiwale                        # "none" desativa
SEED_BCHIWALE_ORIGINS=https://bchiwale.com # domínios autorizados (CORS) da API pública; vazio = qualquer origem
SEED_BCHIWALE_URL=https://bchiwale.com

# Opcional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backups / deploy (ver docs/backups.md e docs/updates.md)
BACKUP_TOKEN=                              # >= 16 caracteres (openssl rand -hex 24); liga a API ao serviço de backups
BACKUP_TIMES=03:00                         # horas UTC, separadas por vírgula
# Offsite (recomendado). Exemplo S3/Backblaze/R2:
# BACKUP_OFFSITE=offsite:meu-bucket/dynamix
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare   # ou Other, AWS, ...
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
IMAGE_TAG=latest                           # tag das imagens (o CI move 'latest' após testes; ou fixar um SHA para rollback manual)
IMAGE_PREFIX=ghcr.io/delciomanico/dynamix-cms
